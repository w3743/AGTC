# ===== v27 运行时对零（AT 命令）实测（2026-10-25 19:00~19:03，A=server COM22 / B=client COM23，实际间距 76cm）=====
# 背景：v25 的开机自对零目标写死 500mm，板子拉到 76cm 后 D 只有 1.1~1.45m；
#       v26 想在日志口(UART1)做串口命令，但日志口是 DMA-RX、RX 引脚未接 CH340，收不到字节。
#       排查时发现 SDK 的 AT 框架是开着的（UART0/CH340，115200）：发送 "AT" 返回 "OK"。
# v27 改为注册标准 AT 命令 AT+RDTARE，实测通过：
#   [RL] AT cmd RDTARE register ret=0x0
#   AT+RDTARE=760  -> OK; [RL] tare ok: raw_med=1776mm target=760mm offset=1016mm
#   D 立即由 ~750 变到 760，随后 75s 中位 798mm（+38mm）、σ≈10mm、范围 774~821mm、0 复位
[RL] AT+RDTARE=760mm accepted
[RL] tare ok: raw_med=1776mm target=760mm offset=1016mm
[RL] server D=760mm D1=1776mm D2=1802mm PROB=1000 SN=6 RSSI=-33dBm RX_SEQ=2155 RX_CNT=2
[RL] server D=798mm D1=1810mm D2=1820mm PROB=1000 SN=6 RSSI=-33dBm RX_SEQ=2160 RX_CNT=5
# 用法：换距离后在串口发 AT+RDTARE=<实际mm>；查询 AT+RDTARE? -> +RDTARE:<raw_med>,<offset>
# ===== v28 两点线性校准（2026-10-25 20:18，A=server COM22）=====
# 烧录成功；AT 命令注册 ret=0x0；实测：
#   AT+RDFIT?  -> +RDFIT:0,1000,994  /  OK   （点数0, SCALE=1000permille, OFFSET=994mm）
#   AT+RDTARE? -> +RDTARE:0,994      /  OK
# 测距行新增校准参数：SC=1000 OF=994
# 拟合用法（每个距离点发一次）：AT+RDCLR -> AT+RDFIT=500 -> AT+RDFIT=1000 -> 自动最小二乘并生效
# 换算：raw=a*true+b -> SCALE_PM=1000/a, OFFSET_MM=b/a（官方基线两点得 833permille / 800mm）
[RL] server D=621mm D1=1606mm D2=1570mm PROB=1000 SN=5 RSSI=-34dBm SC=1000 OF=994 RX_SEQ=2943 RX_CNT=1
