      <joint name="gimbal_yaw_joint" type="revolute">
        <parent>base_link</parent>
        <child>gimbal_yaw_link</child>
        <pose relative_to="base_link">0 0 0.4 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-3.14159265</lower>
            <upper>3.14159265</upper>
            <effort>20</effort>
            <velocity>3</velocity>
          </limit>
        </axis>
      </joint>
      <link name="gimbal_pitch_link">
        <pose>0 0 0.4 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.4</mass>
          <inertia>
            <ixx>0.000203333333</ixx>
            <iyy>0.000416666667</iyy>
            <izz>0.000453333333</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <sensor name="field_lidar" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>/field/lidar/scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>400</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.12588469</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>8</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
        <sensor name="field_depth_camera" type="depth_camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>2.5</update_rate>
          <visualize>false</visualize>
          <topic>/field/depth/image</topic>
          <camera>
            <horizontal_fov>0.841540074</horizontal_fov>
            <image>
              <width>88</width>
              <height>160</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.3</near>
              <far>5</far>
            </clip>
            <lens>
              <type>gnomonical</type>
              <intrinsics>
                <fx>98.3247986</fx>
                <fy>98.3247986</fy>
                <cx>44.0112534</cx>
                <cy>80.5578613</cy>
                <s>0</s>
              </intrinsics>
            </lens>
            <depth_camera>
              <output>depths</output>
              <clip>
                <near>0.3</near>
                <far>5</far>
              </clip>
            </depth_camera>
            <camera_info_topic>/field/depth/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </link>
      <joint name="gimbal_pitch_joint" type="revolute">
        <parent>gimbal_yaw_link</parent>
        <child>gimbal_pitch_link</child>
        <pose relative_to="gimbal_yaw_link">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit>
            <lower>-0.436332313</lower>
            <upper>1.04719755</upper>
            <effort>20</effort>
            <velocity>3</velocity>
          </limit>
        </axis>
      </joint>
      <plugin name="gz::sim::systems::TrackedVehicle" filename="gz-sim-tracked-vehicle-system">
        <left_track>
          <link>left_track</link>
          <velocity_topic>/field/track/left/velocity</velocity_topic>
          <center_of_rotation_topic>/field/track/left/center_of_rotation</center_of_rotation_topic>
        </left_track>
        <right_track>
          <link>right_track</link>
          <velocity_topic>/field/track/right/velocity</velocity_topic>
          <center_of_rotation_topic>/field/track/right/center_of_rotation</center_of_rotation_topic>
        </right_track>
        <tracks_separation>0.22</tracks_separation>
        <track_height>0.11</track_height>
        <steering_efficiency>0.5</steering_efficiency>
        <topic>/field/cmd_vel</topic>
        <odom_publish_frequency>20</odom_publish_frequency>
        <odom_topic>/field/odom</odom_topic>
        <tf_topic>/field/tf</tf_topic>
        <frame_id>field_odom</frame_id>
        <child_frame_id>field_robot/base_link</child_frame_id>
      </plugin>
      <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system">
        <link>left_track</link>
        <track_orientation>0 0 0</track_orientation>
        <velocity_topic>/field/track/left/velocity</velocity_topic>
        <center_of_rotation_topic>/field/track/left/center_of_rotation</center_of_rotation_topic>
        <min_velocity>-4.16666667</min_velocity>
        <max_velocity>4.16666667</max_velocity>
      </plugin>
      <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system">
        <link>right_track</link>
        <track_orientation>0 0 0</track_orientation>
        <velocity_topic>/field/track/right/velocity</velocity_topic>
        <center_of_rotation_topic>/field/track/right/center_of_rotation</center_of_rotation_topic>
        <min_velocity>-4.16666667</min_velocity>
        <max_velocity>4.16666667</max_velocity>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>gimbal_yaw_joint</joint_name>
        <topic>/field/gimbal/yaw/cmd_pos</topic>
        <initial_position>0</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.5</cmd_max>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>gimbal_pitch_joint</joint_name>
        <topic>/field/gimbal/pitch/cmd_pos</topic>
        <initial_position>0</initial_position>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>0.5</cmd_max>
      </plugin>
      <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
        <topic>/field/joint_states</topic>
      </plugin>
    </model>
