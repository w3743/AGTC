      <link name="gimbal_yaw_link">
        <pose>0 0 0.4 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.6</mass>
          <inertia>
            <ixx>0.000765</ixx>
