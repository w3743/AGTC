      <link name="gimbal_yaw_link">
        <pose>0 0 0.4 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.6</mass>
          <inertia>
            <ixx>0.000765</ixx>
            <iyy>0.000765</iyy>
            <izz>0.00144</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
