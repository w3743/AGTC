    <model name="field_robot">
      <pose>-48 -48 0.131261184 0.118344471 -0.0784545928 0.785398163</pose>
      <link name="base_link">
        <inertial>
          <pose>0 0 0.147777778 0 0 0</pose>
          <mass>27</mass>
          <inertia>
            <ixx>0.082125</ixx>
            <iyy>1.204425</iyy>
            <izz>1.2105</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <pose>0 0 0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>0.72 0.14 0.13</size>
            </box>
          </geometry>
        </collision>
        <visual name="chassis_visual">
          <pose>0 0 0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>0.72 0.14 0.13</size>
            </box>
          </geometry>
          <material>
            <ambient>0.23 0.27 0.28 1</ambient>
            <diffuse>0.23 0.27 0.28 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
        <sensor name="field_imu" type="imu">
          <pose>0 0 0.3 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <visualize>false</visualize>
          <topic>/field/imu/data</topic>
          <imu />
        </sensor>
        <sensor name="field_magnetometer" type="magnetometer">
          <pose>0 0 0.3 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>false</visualize>
          <topic>/field/magnetometer/data</topic>
          <magnetometer />
        </sensor>
      </link>
      <link name="left_track">
        <pose>0 0.11 0.055 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>0.00154166667</ixx>
            <iyy>0.0543416667</iyy>
            <izz>0.0538666667</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="left_track_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.08 0.11</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>150</mu2>
                <fdir1>1 0 0</fdir1>
