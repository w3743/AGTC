    <model name="field_robot">
      <pose>-48 -48 -0.160455115 0.0548780981 -0.0217377142 0.785398163</pose>
      <link name="base_link">
        <inertial>
          <pose>0 0 0.147777778 0 0 0</pose>
          <mass>27</mass>
          <inertia>
            <ixx>0.082125</ixx>
            <iyy>1.204425</iyy>
            <izz>1.2105</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <pose>0 0 0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>0.72 0.14 0.13</size>
            </box>
          </geometry>
        </collision>
        <visual name="chassis_visual">
