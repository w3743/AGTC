        <sensor name="field_imu" type="imu">
          <pose>0 0 0.3 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <visualize>false</visualize>
          <topic>/field/imu/data</topic>
          <imu />
        </sensor>
        <sensor name="field_magnetometer" type="magnetometer">
          <pose>0 0 0.3 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>false</visualize>
          <topic>/field/magnetometer/data</topic>
          <magnetometer />
        </sensor>
      </link>
      <link name="left_track">
        <pose>0 0.11 0.055 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>0.00154166667</ixx>
            <iyy>0.0543416667</iyy>
            <izz>0.0538666667</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="left_track_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.08 0.11</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
