        <visual name="right_track_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.08 0.11</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.12 0.13 1</ambient>
