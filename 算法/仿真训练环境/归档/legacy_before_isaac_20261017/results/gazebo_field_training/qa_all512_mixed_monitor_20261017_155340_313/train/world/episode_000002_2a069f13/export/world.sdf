            <specular>0.05 0.05 0.05 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
      <joint name="left_track_fixed_joint" type="fixed">
        <parent>base_link</parent>
        <child>left_track</child>
        <pose relative_to="base_link">0 0.11 0.055 0 0 0</pose>
      </joint>
      <link name="right_track">
        <pose>0 -0.11 0.055 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>0.00154166667</ixx>
            <iyy>0.0543416667</iyy>
            <izz>0.0538666667</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="right_track_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.08 0.11</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>150</mu2>
                <fdir1>1 0 0</fdir1>
