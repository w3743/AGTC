$html = Get-Content -LiteralPath 'isaac_field/visualization/network_2d.html' -Raw
$scriptText = [regex]::Match($html, '(?s)<script>\s*(.*?)</script>').Groups[1].Value
Set-Content -LiteralPath $tempJs -Value $scriptText -Encoding utf8
node --check $tempJs
$checkResult = $LASTEXITCODE
Remove-Item -LiteralPath $tempJs
exit $checkResult
