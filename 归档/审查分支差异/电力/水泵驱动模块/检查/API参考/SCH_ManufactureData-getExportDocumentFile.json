{
  "title": "获取导出文档文件",
  "remarks": "可以使用 {@link SYS_FileSystem.saveFile} 接口将文件导出到本地文件系统",
  "params": [
    {
      "name": "fileName",
      "type": "string",
      "description": "文件名",
      "required": false
    },
    {
      "name": "fileType",
      "type": "ESCH_ExportDocumentFileType",
      "description": "文件类型",
      "required": false
    },
    {
      "name": "typeSpecificParams",
      "type": "{ theme?: \"Default\" | \"White on Black\" | \"Black on White\"; lineWidth?: \"Default\" | \"Always 1px\" | \"Follow the Zoom Change\"; displayAttributesAsMenu?: boolean; size?: \"Original Size\" | string | { width: number; height: number; unit: \"inch\" | \"mm\" } }",
      "description": "类型特定参数",
      "required": false
    },
    {
      "name": "object",
      "type": "\"All Schematic\" | \"Current Schematic\" | \"Current Schematic Page\" | string",
      "description": "对象",
      "required": false
    },
    {
      "name": "objectSpecificParams",
      "type": "{ range?: \"All\" | array; outputMethod?: \"Merged sheet\" | \"Separated sheet\" }",
      "description": "对象特定参数",
      "required": false
    }
  ],
  "returns": {
    "type": "null"
  },
  "deprecated": "- DEPRECATED since EDA v4.1"
}