{"type":"COMPONENT","ticket":91205,"id":"21c72c5c4b0c50b7"}||{"partitionId":"","groupId":0,"layerId":1,"x":688.736,"y":-8829.4069,"angle":0,"attrs":{"Description":"","Reuse Block":"","Group ID":"","Channel ID":"$1I1167","Unique ID":"R_LOAD_POWER_VALID_GATE","Electrical manifest":"R_LOAD_POWER_VALID_GATE","Design source":"接口","Design note":"Tyohm幸亚1kΩ ±1%栅极串联电阻；配合100k栅源下拉，保留FET_RELEASE低/失电默认关断。 普通电阻跨板复用：Tyohm幸亚RMC06031K1%N，0603、±1%、0.1W、50V、独立两脚，非排阻。沿用原阻值和引脚网络；此组支路两端工作差分≤3.6V，按3.6V逻辑及8.4V两节均衡供电上限，各阻值保守计算耗散不超过13.1mW。与稳压板同订货号，不能继承旧精确器件库绑定。数据依据见检查/普通电阻跨板复用依据.md。现行报价及MOQ边界见检查/当前主板成本.csv。","Engineering Description":"1kΩ ±1%, 0603, 100mW, 50V","DeviceName":"{\"name\":\"RMC06031K1%N\",\"source\":\"\",\"uuid\":\"728fa010dc8c7fb9\"}"},"locked":false,"zIndex":-1,"pinSwap":false,"pinSwapInfo":{"21c72c5c4b0c50b7e7":{"pinClass":"","differentialPairClass":""},"21c72c5c4b0c50b7e8":{"pinClass":"","differentialPairClass":""}},"footprintPrimitives":true}|
