{"type":"META","ticket":228,"id":"META"}||{"title":"DRV8262DDWR_C22427252","tags":["电机驱动芯片","步进电机驱动芯片"],"source":"7e7ea239b19d4650ae10d06c6ce34213|0819f05c4eef4c71ace90d822a990e87","images":["https://alimg.szlcsc.com/upload/public/product/middle/20240626/82B44DAEACA6176BA5476D05C7C0D47D.jpg"],"attributes":{"LCSC Part Name":"具有电流检测输出的60V单路或双路H桥电机驱动器","Supplier Part":"C22427252","Manufacturer":"TI(德州仪器)","Manufacturer Part":"DRV8262DDWR","Supplier Footprint":"HTSSOP-44","JLCPCB Part Class":"Extended Part","Datasheet":"https://www.ti.com.cn/cn/lit/ds/symlink/drv8262.pdf?ts=1739430776070&ref_url=https%253A%252F%252Fwww.ti.com.cn%252Fsitesearch%252Fzh-cn%252Fdocs%252Funiversalsearch.tsp%253FlangPref%253Dzh-CN%2526nr%253D15%2526searchTerm%253DDRV8262DDWR","Supplier":"LCSC","Add into BOM":"yes","Convert to PCB":"yes","Symbol":"a6d171dcb810515c","Designator":"U?","Footprint":"d06f383369fed96d","3D Model":"c3253cc1ed7c40e189f59907d1f11bb8|0819f05c4eef4c71ace90d822a990e87","3D Model Title":"HTSSOP-44_L14.0-W6.1-P0.64-LS8.1-BL-EP-4","3D Model Transform":"551.18,318.897,0,0,0,0,0,0,0","Control Voltage":"3.05V~5.5V","Motor Drive Voltage(Vm)":"4.5V~65V","Output Current":"-","Number of H-bridges":"2","Drive Type":"双极驱动","Step Resolution":"-","Interface":"-","Technology":"是","RDS(on)":"100mΩ","Operating Temperature":"-40℃~+125℃","Features":"内置电荷泵；过流保护；上电复位；死区/直通保护；过压保护；过温保护；欠压锁定","Name":"={Manufacturer Part}","Description":"一款宽电压、高功率H桥电机驱动器，适用于各种工业应用。该器件集成了两个H桥来驱动一个或两个直流电机或一个双极步进电机。在双路H桥模式下支持高达16A的峰值电流，在单路H桥模式下支持高达32A的峰值电流。该器件还集成了电流检测和调节、电流检测输出以及保护电路","SymbolName":"{\"name\":\"DRV8262DDWR_C22427252\",\"uuid\":\"a6d171dcb810515c\",\"source\":\"\"}","FootprintName":"{\"name\":\"HTSSOP-44_L14.0-W6.1-P0.64-LS8.1-BL-EP-4\",\"uuid\":\"d06f383369fed96d\",\"source\":\"\"}"}}|
