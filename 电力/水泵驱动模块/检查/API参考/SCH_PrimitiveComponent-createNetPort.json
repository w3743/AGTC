{
  "title": "创建网络端口",
  "params": [
    {
      "name": "direction",
      "type": "\"IN\" | \"OUT\" | \"BI\"",
      "description": "端口方向",
      "required": true
    },
    {
      "name": "net",
      "type": "string",
      "description": "网络名称",
      "required": true
    },
    {
      "name": "x",
      "type": "number",
      "description": "坐标 X",
      "required": true
    },
    {
      "name": "y",
      "type": "number",
      "description": "坐标 Y",
      "required": true
    },
    {
      "name": "rotation",
      "type": "number",
      "description": "旋转角度",
      "required": false
    },
    {
      "name": "mirror",
      "type": "boolean",
      "description": "是否镜像",
      "required": false
    }
  ],
  "returns": {
    "type": "ISCH_PrimitiveComponent | null"
  }
}