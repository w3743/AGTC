{
  "title": "获取工程文件",
  "remarks": "可以使用 {@link SYS_FileSystem.saveFile} 接口将文件导出到本地文件系统\n\n注意：本接口需要启用 **工程管理 \\> 下载工程** 权限，没有权限调用将始终 `throw Error`",
  "params": [
    {
      "name": "fileName",
      "type": "string",
      "description": "文件名",
      "required": false
    },
    {
      "name": "password",
      "type": "string",
      "description": "加密密码",
      "required": false
    },
    {
      "name": "fileType",
      "type": "\"epro\" | \"epro2\"",
      "description": "文件格式",
      "required": false
    }
  ],
  "returns": {
    "type": "null"
  }
}