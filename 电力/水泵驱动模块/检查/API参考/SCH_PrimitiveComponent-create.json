{
  "title": "创建器件",
  "params": [
    {
      "name": "component",
      "type": "{ libraryType?: \"3\"; libraryUuid: string; uuid: string } | ILIB_DeviceItem | ILIB_DeviceSearchItem | { libraryType: \"2\"; libraryUuid: string; uuid: string } | ILIB_SymbolItem | ILIB_SymbolSearchItem",
      "description": "关联库器件",
      "required": true
    },
    {
      "name": "x",
      "type": "number",
      "description": "坐标 X",
      "required": true
    },
    {
      "name": "y",
      "type": "number",
      "description": "坐标 Y",
      "required": true
    },
    {
      "name": "subPartName",
      "type": "string",
      "description": "子部件名称",
      "required": false
    },
    {
      "name": "rotation",
      "type": "number",
      "description": "旋转角度",
      "required": false
    },
    {
      "name": "mirror",
      "type": "boolean",
      "description": "是否镜像",
      "required": false
    },
    {
      "name": "addIntoBom",
      "type": "boolean",
      "description": "是否加入 BOM",
      "required": false
    },
    {
      "name": "addIntoPcb",
      "type": "boolean",
      "description": "是否转到 PCB",
      "required": false
    }
  ],
  "returns": {
    "type": "ISCH_PrimitiveComponent | null"
  }
}