  "critical_device_pin_review": [
    {
      "ref": "U_DRV",
      "part": "DRV8262DDWR",
      "package": "DDW HTSSOP-44 plus exposed pad 45",
      "pin_mapping": "完整逐脚映射列于 pin_check_evidence.pin_matrix：1=VCP; 2/11/12/21=BUS_M; 3/10/13/20/22/23/27/37/45=GND_SYS; 4/5/6/17/18/19=MOTOR_A; 7/8/9/14/15/16=MOTOR_B; 24=DRV_DVDD; 25=+5V; 26=DRV_NFAULT; 28/29=DRV_DVDD; 30/31=IPROPI; 32/36/38/39=NC; 33/34=DRV_VREF; 35=DRV_DVDD; 40=DRV_IN2; 41=DRV_IN1; 42=DRV_SLEEP; 43=DRV_CPL; 44=DRV_CPH.",
      "findings": "所有44脚和散热焊盘的网名与合同一致；两桥输出并联，VM/GND并联，MODE1/2置高选择单H桥并桥；VCP-DVDD-CP/VREF/TOFF/DECAY外围与TI连接方式相符。",
      "boundary": "IPROPI和限流值为器件/电阻模型。20kHz时的真实电机峰值、制动电流、温度与安全时间尚未通过实泵/示波器验证。"
    },
    {
      "ref": "U_5V",
      "part": "XL7015E1",
      "pin_mapping": "完整逐脚映射列于 pin_check_evidence.pin_matrix：1=BUS_M/VIN; 2=XL_SW; 3=GND_SYS; 4=XL_FB; 5=GND_SYS/EN低使能; 6=GND_SYS/散热焊盘。",
      "findings": "VIN、SW、FB、GND及低有效EN连接符合XL7015脚位；L_5V接SW至+5V，D_5V阳极到GND/阴极到SW，330uF/16V输出和10k/3.3k反馈给出约5.04V标称；100uH电感/100V肖特基与厂家典型拓扑一致。",
      "boundary": "0.3A是预算，不是实测负载。5V启动、环路稳定、整流/电感纹波和热状态需整板测试。"
    },
    {
      "ref": "U_CAN",
      "part": "TCAN1042HGVDRQ1",
      "pin_mapping": "完整逐脚映射列于 pin_check_evidence.pin_matrix：1=CAN_TX; 2=GND_SYS; 3=+5V; 4=CAN_RX; 5=+3V3/VIO; 6=CANL; 7=CANH; 8=CAN_STB。",
      "findings": "引脚映射与TI定义一致；CAN_STB高待机、低正常，10k上拉提供复位/未驱动默认待机；TXD上拉保持隐性；CAN线端TVS和可选120R终端网连接正确。",
      "boundary": "终端电阻是否装配取决于整车物理总线末端；波特率、报文ID/周期、线束拓扑及ESD/EMC需系统集成确认。"
    },
    {
      "ref": "J_MCU_A/J_MCU_B/U_MCU",
      "part": "WeAct Normal QFN48 STM32G431CBU6核心板",
      "pin_mapping": "J_MCU_A/B各24脚均逐脚在pin_check_evidence.pin_matrix中；关键信号为P1-10 PA8/TIM1_CH1=DRV_IN2，P1-16 PC10=CAN_STB，P1-17 PC11=DRV_nFAULT，P1-20 PB5=DRV_IN1，P1-22 PB7=DRV_SLEEP，P1-23 PB8=CAN_RX，P1-24 PB9=CAN_TX；P2-17 PA1=ADC_BUS，P2-18 PA2=ADC_NTC，P2-20 PA0=ADC_I；P2-7/P2-8及其余未用排针脚NC。",
      "findings": "按本地WeAct QFN48 V1.0 pin map核对，合同脚位/功能匹配，未把P2-7(PB2/USB VBUS相关)或P2-8(VREF+)当GPIO；BUS分压1/23量程在理论9S母线边界内，NTC只测本板，IPROPI信号经滤波入ADC。",
      "boundary": "需读回核心板选项字节确认PB8启动配置；实际核心板版本、PCB排针方向及ADC/DMA/PWM采样时序需台架验证。"
